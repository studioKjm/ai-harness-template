{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "STRICT preset — Production/client projects. Maximum restrictions. Syntax: Bash(cmd *) (the old Bash(cmd:*) form is no longer supported by Claude Code). deny rules can be bypassed through shell tricks; pair them with PreToolUse hooks or /sandbox for hard guarantees.",
  "permissions": {
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(DROP TABLE *)",
      "Bash(DROP DATABASE *)",
      "Bash(DELETE FROM *)",
      "Bash(TRUNCATE *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(chmod 777 *)",
      "Bash(curl * | sh)",
      "Bash(wget * | sh)",
      "Bash(eval *)",
      "Bash(sudo *)",
      "Read(./.env.production*)",
      "Edit(./.env.production*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)"
    ],
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.harness/hooks/post-edit-lint.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
